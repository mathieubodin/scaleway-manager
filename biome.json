{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "tests/workflows/**/*.js",
      "**/*.json",
      "!tests/workflows/fixtures",
      "!_bmad",
      "!.claude/skills/bmad-*",
      "!package-lock.json",
      "!**/cost.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}
